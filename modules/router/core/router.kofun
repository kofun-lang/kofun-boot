# kofun-boot functional core: dispatch and handlers.
#
# Nothing in this file may name a capability constructor. That is not a
# convention — tests/boot/check.sh reads this file with comments stripped and
# fails on any capability name, so the boundary is a gate rather than a
# paragraph. Handlers receive their capabilities as an argument because the
# language gives them no ambient authority to reach instead.
#
# The module shell (../shell/router.kofun) owns the table, the capability
# record, and every emission. scripts/build-seed.sh concatenates the two, the way
# framework/http/build.sh combines its declarations with an application.
#
fn method_get() -> Int {
    return 1
}

fn method_post() -> Int {
    return 2
}

fn method_bit(method: Int) -> Int {
    if method == method_get() {
        return 1
    }
    return 2
}

fn path_hello() -> Int {
    return 101
}

fn path_sum() -> Int {
    return 102
}

fn path_bench() -> Int {
    return 103
}

# The base of a capturing route: `/things/:id`. A slot declares the base; a
# request against it arrives as base * capture_base() + the captured code.
fn path_thing() -> Int {
    return 104
}

# How a captured code is carried inside a path code. The canonical surface
# routes on Text segments and captures a segment; the Core has no Text in
# records, so the captured value rides in the low digits of the path code and
# the base is what a slot matches on. The arithmetic is the projection, not the
# rule: the rule is that a capturing slot matches a family and a non-capturing
# slot matches one code.
fn capture_base() -> Int {
    return 1000
}

fn capturing() -> Int {
    return 1
}

fn literal() -> Int {
    return 0
}

fn body_limit() -> Int {
    return 4096
}

# ------------------------------------------------------ capability manifest
#
# The type already enforces: a function never handed a filesystem capability
# cannot touch a filesystem, because it does not compile. That is a stronger
# mechanism than an ACL file, and it is still not a complete answer.
#
# A capability set visible only by reading code is auditable by developers. One
# that can be printed and diffed is auditable by an operator — and the people
# who must answer "what can this binary reach?" during an incident are
# frequently not the people who can read the composition root, and are never
# reading it for the binary actually running.
#
# So the shell prints the set. It is derived from the record rather than
# maintained beside it, which is why it cannot drift: every row's state is a
# field of Capabilities, and a row whose field is gone does not compile.

# A capability nobody handed this binary. Zero, so a scope and its absence are
# the same field rather than a flag beside one.
fn capability_denied() -> Int {
    return 0
}

fn is_granted(scope: Int) -> Int {
    if scope == capability_denied() {
        return 0
    }
    return 1
}

# The contract this manifest is written against, so a printed manifest can be
# read years later by someone holding a different version of this repository.
fn boot_contract_version() -> Int {
    return 1
}

# The build identity: a digest of the Capabilities declaration itself.
#
# A git revision would be the obvious choice and is the wrong one here. It
# changes on every commit, so a byte-compared golden would churn for reasons
# that have nothing to do with capabilities, and the manifest would stop being
# diffable across deployments for the property it exists to report. A digest of
# the declaration changes exactly when the capability surface changes, which is
# the question an operator diffing two manifests is actually asking.
#
# scripts/capability-digest.sh computes it, and tests/boot/check.sh recomputes
# it from the source and refuses a printed value that disagrees — so editing
# the record without updating this constant fails by name rather than shipping
# a manifest that describes the previous binary.
fn capability_digest() -> Int {
    return 226362803
}

fn kind_matched() -> Int {
    return 1
}

fn kind_not_found() -> Int {
    return 2
}

fn kind_method_not_allowed() -> Int {
    return 3
}

fn kind_payload_too_large() -> Int {
    return 4
}

# ---------------------------------------------------------------- values

# A parsed request. Paths arrive as codes because the Core has no Text in
# records; the canonical surface routes on Text segments.
type Request = {
    method: Int,
    path: Int,
    body_bytes: Int,
}

# One route slot: the compiled form of one contract line. The capture flag is
# part of the slot rather than inferred from the path code, so what a route
# captures is a compiled property a reader can see rather than a shape a
# matcher guesses at.
type Route = {
    method: Int,
    path: Int,
    handler: Int,
    capture: Int,
}

# The whole table. Fixed shape, because the table is data at build time —
# there is no route registration at run time and no way to express it here.
type RouteTable = {
    r0_method: Int,
    r0_path: Int,
    r0_handler: Int,
    r0_capture: Int,
    r1_method: Int,
    r1_path: Int,
    r1_handler: Int,
    r1_capture: Int,
    r2_method: Int,
    r2_path: Int,
    r2_handler: Int,
    r2_capture: Int,
    r3_method: Int,
    r3_path: Int,
    r3_handler: Int,
    r3_capture: Int,
    r4_method: Int,
    r4_path: Int,
    r4_handler: Int,
    r4_capture: Int,
}

# The closed dispatch result. Every failure carries what was observed:
# MethodNotAllowed carries the Allow set as method bits, PayloadTooLarge
# carries the limit that was exceeded. No case defaults.
type RouteResult =
    | Matched(handler: Int)
    | NotFound(path: Int)
    | MethodNotAllowed(allowed: Int)
    | PayloadTooLarge(limit: Int)

# One dispatch outcome, flattened. A Matched result now has two things to
# report — the handler and what the route captured — and the slice allows one
# payload per constructor. So the capture travels in a record beside the sum
# rather than as a second payload, which is the shape modules/effects uses for
# EffectStep and the language uses for its tzdb surfaces.
#
# The capture is printed for every outcome, not only for Matched. A field that
# appears only when it is interesting cannot be read for absence, and absence
# — this route captured nothing — is the property that distinguishes a
# capturing slot from a literal one.
type Dispatch = {
    kind: Int,
    payload: Int,
    capture: Int,
}

# The capability record a seed handler receives. There is no ambient clock to
# reach instead — that is the language, and the framework keeps it that way.
#
# Every field is a *scope*, not a boolean. A capability system whose grants are
# booleans is a feature-flag system with better vocabulary: a filesystem
# capability is not "the filesystem", it names its roots, and a network
# capability names what it may reach. `capability_denied()` — zero — is how a
# field says the binary was not handed that authority at all, which is what
# makes the manifest readable for absence.
#
# A credential-carrying capability names its store, never its material. The
# material does not enter this record, so no projection of the record can leak
# it — that is a property of the shape rather than of a redaction pass.
type Capabilities = {
    monotonic_ms: Int,
    now_seconds: Int,
    tzdb_year: Int,
    entropy_seed: Int,
    log_sink: Int,
    credential_store: Int,
    net_listen_port: Int,
    net_connect_host: Int,
    fs_root: Int,
}

# What a handler produces. Pure data out; the shell decides what to do with it.
type Response = {
    status: Int,
    body_code: Int,
}

# ------------------------------------------------------- result accessors

fn result_kind(result: RouteResult) -> Int {
    let mut kind = 0
    match result {
        Matched(_) => { kind = kind_matched() },
        NotFound(_) => { kind = kind_not_found() },
        MethodNotAllowed(_) => { kind = kind_method_not_allowed() },
        PayloadTooLarge(_) => { kind = kind_payload_too_large() },
    }
    return kind
}

fn result_payload(result: RouteResult) -> Int {
    let mut payload = 0
    match result {
        Matched(handler) => { payload = handler },
        NotFound(path) => { payload = path },
        MethodNotAllowed(allowed) => { payload = allowed },
        PayloadTooLarge(limit) => { payload = limit },
    }
    return payload
}

# ------------------------------------------------------------ the table

fn boot_table() -> RouteTable {
    let table: RouteTable = RouteTable(
        r0_method: method_get(),
        r0_path: path_hello(),
        r0_handler: 1,
        r0_capture: literal(),
        r1_method: method_post(),
        r1_path: path_sum(),
        r1_handler: 2,
        r1_capture: literal(),
        r2_method: method_get(),
        r2_path: path_bench(),
        r2_handler: 3,
        r2_capture: literal(),
        r3_method: method_post(),
        r3_path: path_bench(),
        r3_handler: 4,
        r3_capture: literal(),
        r4_method: method_get(),
        r4_path: path_thing(),
        r4_handler: 5,
        r4_capture: capturing()
    )
    return table
}

# ------------------------------------------------------------- dispatch

fn eq_flag(left: Int, right: Int) -> Int {
    if left == right {
        return 1
    }
    return 0
}

# Whether one slot's path matches the request's, which is the only place the
# capture flag changes the matcher. A capturing slot matches the family that
# shares its base; a literal slot matches its code exactly, so a request whose
# path merely *looks* captured — a code with the same digit shape — does not
# match a literal slot that happens to sit at its base.
fn slot_hit(slot_path: Int, slot_capture: Int, request_path: Int) -> Int {
    if slot_capture == capturing() {
        return eq_flag(request_path // capture_base(), slot_path)
    }
    return eq_flag(request_path, slot_path)
}

# What a slot captured from the request's path. A literal slot captures
# nothing, and says so with 0 rather than by omitting the value.
fn slot_capture(slot_capture_flag: Int, request_path: Int) -> Int {
    if slot_capture_flag == capturing() {
        return request_path % capture_base()
    }
    return 0
}

# How many slots share the request's path. Five comparisons, always.
fn path_hits(table: RouteTable, request: Request) -> Int {
    return slot_hit(table.r0_path, table.r0_capture, request.path)
        + slot_hit(table.r1_path, table.r1_capture, request.path)
        + slot_hit(table.r2_path, table.r2_capture, request.path)
        + slot_hit(table.r3_path, table.r3_capture, request.path)
        + slot_hit(table.r4_path, table.r4_capture, request.path)
}

# The Allow set for the request's path, as method bits. A slot contributes its
# method bit exactly when its path matches; a path with GET and POST slots
# yields 3. Sums stay exact because each slot contributes one bit at most
# and the two bits are distinct powers of two.
fn allowed_set(table: RouteTable, request: Request) -> Int {
    return slot_hit(table.r0_path, table.r0_capture, request.path)
            * method_bit(table.r0_method)
        + slot_hit(table.r1_path, table.r1_capture, request.path)
            * method_bit(table.r1_method)
        + slot_hit(table.r2_path, table.r2_capture, request.path)
            * method_bit(table.r2_method)
        + slot_hit(table.r3_path, table.r3_capture, request.path)
            * method_bit(table.r3_method)
        + slot_hit(table.r4_path, table.r4_capture, request.path)
            * method_bit(table.r4_method)
}

# The handler for the slot whose method AND path both match, or 0. At most one
# slot can match because the table refuses duplicate (method, path) pairs at
# build time — the gate proves the table holds that today.
fn matched_handler(table: RouteTable, request: Request) -> Int {
    let hit0: Int = slot_hit(table.r0_path, table.r0_capture, request.path)
        * eq_flag(table.r0_method, request.method)
    let hit1: Int = slot_hit(table.r1_path, table.r1_capture, request.path)
        * eq_flag(table.r1_method, request.method)
    let hit2: Int = slot_hit(table.r2_path, table.r2_capture, request.path)
        * eq_flag(table.r2_method, request.method)
    let hit3: Int = slot_hit(table.r3_path, table.r3_capture, request.path)
        * eq_flag(table.r3_method, request.method)
    let hit4: Int = slot_hit(table.r4_path, table.r4_capture, request.path)
        * eq_flag(table.r4_method, request.method)
    return hit0 * table.r0_handler
        + hit1 * table.r1_handler
        + hit2 * table.r2_handler
        + hit3 * table.r3_handler
        + hit4 * table.r4_handler
}

# What the matching slot captured, or 0. Same fixed-rank shape as the handler
# lookup and for the same reason: at most one slot matches, so the sum is that
# slot's capture. A slot that matched on method alone contributes nothing,
# which is what keeps this from reporting a capture for a route that was not
# taken.
fn matched_capture(table: RouteTable, request: Request) -> Int {
    let hit0: Int = slot_hit(table.r0_path, table.r0_capture, request.path)
        * eq_flag(table.r0_method, request.method)
    let hit1: Int = slot_hit(table.r1_path, table.r1_capture, request.path)
        * eq_flag(table.r1_method, request.method)
    let hit2: Int = slot_hit(table.r2_path, table.r2_capture, request.path)
        * eq_flag(table.r2_method, request.method)
    let hit3: Int = slot_hit(table.r3_path, table.r3_capture, request.path)
        * eq_flag(table.r3_method, request.method)
    let hit4: Int = slot_hit(table.r4_path, table.r4_capture, request.path)
        * eq_flag(table.r4_method, request.method)
    return hit0 * slot_capture(table.r0_capture, request.path)
        + hit1 * slot_capture(table.r1_capture, request.path)
        + hit2 * slot_capture(table.r2_capture, request.path)
        + hit3 * slot_capture(table.r3_capture, request.path)
        + hit4 * slot_capture(table.r4_capture, request.path)
}

# The dispatch order is the contract, and the gate reads it: size before
# route, route before method. A body over the limit is refused before the
# table is consulted, so an attacker cannot probe the route space with
# oversized requests; an unknown path is NotFound regardless of method; a
# known path with the wrong method names the methods that would have worked.
fn dispatch(table: RouteTable, request: Request) -> RouteResult {
    if request.body_bytes > body_limit() {
        return PayloadTooLarge(body_limit())
    }
    let handler: Int = matched_handler(table, request)
    if handler > 0 {
        return Matched(handler)
    }
    if path_hits(table, request) == 0 {
        return NotFound(request.path)
    }
    return MethodNotAllowed(allowed_set(table, request))
}

# The dispatch outcome as one flat value: the closed result, plus what the
# route captured. Only a Matched result can carry a capture — a NotFound
# carries the path it did not match, and reporting a capture beside it would
# claim a route was taken. So the capture is read from the table only when a
# handler was found, and is 0 otherwise.
fn dispatch_of(table: RouteTable, request: Request) -> Dispatch {
    let result: RouteResult = dispatch(table, request)
    let kind: Int = result_kind(result)
    let mut capture: Int = 0
    if kind == kind_matched() {
        capture = matched_capture(table, request)
    }
    let outcome: Dispatch = Dispatch(
        kind: kind,
        payload: result_payload(result),
        capture: capture
    )
    return outcome
}

# A request value. A constructor is pure data assembly, so it belongs to the
# core: a test builds requests without touching the shell at all.
fn request_at(method: Int, path: Int, body_bytes: Int) -> Request {
    let request: Request = Request(
        method: method,
        path: path,
        body_bytes: body_bytes
    )
    return request
}

# ------------------------------------------------------------- handlers
#
# Pure functions. The only time a handler can observe is the time the shell
# handed it, which is what makes every one of these replayable.

fn handle_hello(request: Request, capabilities: Capabilities) -> Response {
    let response: Response = Response(
        status: 200,
        body_code: request.path * 1000 + capabilities.now_seconds
    )
    return response
}

fn handle_sum(request: Request, capabilities: Capabilities) -> Response {
    let response: Response = Response(
        status: 200,
        body_code: request.body_bytes + capabilities.now_seconds
    )
    return response
}
