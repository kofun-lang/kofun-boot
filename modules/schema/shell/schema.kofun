# The schema's imperative shell: replay the history, report drift, print the
# schema and the next plan, and probe the refusals.
#
# Nothing here decides anything. The core decides what each step means; this
# file only chooses which steps to run and prints what came back, in sections
# a script can read and a reader can diff by eye. Every section opens with its
# name and closes with `end <name>`, so a section that grows does not move the
# ones after it — the lesson the capability manifest's `end manifest` marker
# taught the projections that read past it.
#
#   identity `db.schema` and the digest of the declared tables, which every
#            database the SQL projections build records as its marker
#   history  a count, then twelve lines per committed step:
#            step kind table key label column_kind nullable policy ref
#            outcome payload live
#            where live is the live column count of the step's table after it
#   drift    three lines per table — table, 1 InSync or 2 Diverged, what it
#            carried — then the first refused history step, or 0
#   schema   per table: table primary live retired, then per key
#            key label kind nullable state ref
#   plan     per table, per key, the next migration, or kind 0 for none:
#            kind table key label column_kind nullable policy ref
#   regenerate
#            a count, then nine lines per committed step: the step number,
#            then what the planner proposes for that step's key when asked to
#            get from the history before the step to the history after it
#   probes   a count, then eleven lines per probe — a step that must be
#            refused, the outcome it got, and how far it moved the live
#            count, which a refusal may not:
#            kind table key label column_kind nullable policy ref
#            outcome payload live_delta
#
# scripts/ddl.sh projects the schema and history sections into SQL. The gate,
# tests/schema/check.sh, reads every section by name.

fn emit_migration(step: Migration) -> Int {
    print(step.kind)
    print(step.table)
    print(step.key)
    print(step.label)
    print(step.column_kind)
    print(step.nullable)
    print(step.policy)
    print(step.ref)
    return 0
}

# The fold, printed as it goes. Recursion rather than a loop because the slice
# has none, and because a fold is what this is. Each step is applied by the
# same `history_transition` the drift check's replay is built from.
fn emit_history_from(number: Int, last: Int) -> Int {
    if number > last {
        return 0
    }
    let step: Migration = history_step(number)
    let transition: SchemaStep = history_transition(number)
    let outcome: SchemaOutcome = step_outcome(transition)
    print(number)
    emit_migration(step)
    print(outcome_kind(outcome))
    print(outcome_payload(outcome))
    print(live_count(step_schema(transition)))
    return emit_history_from(number + 1, last)
}

fn emit_drift(table: Int) -> Int {
    let found: Drift = drift(declared(table), table_after(table, history_length()))
    print(table)
    print(drift_kind(found))
    print(drift_payload(found))
    return 0
}

fn emit_column(schema: Schema, key: Int) -> Int {
    print(key)
    print(label_at(schema, key))
    print(kind_at(schema, key))
    print(nullable_at(schema, key))
    print(state_at(schema, key))
    print(ref_at(schema, key))
    return 0
}

fn emit_declared(table: Int) -> Int {
    let schema: Schema = declared(table)
    print(schema.table)
    print(schema.primary)
    print(live_count(schema))
    print(retired_count(schema))
    emit_column(schema, 1)
    emit_column(schema, 2)
    emit_column(schema, 3)
    emit_column(schema, 4)
    return 0
}

# From the replayed history to the declaration, for one table. Empty when they
# agree, and the gate requires that: a plan with a step in it is a migration
# somebody has not written yet.
fn emit_plan(table: Int) -> Int {
    let replayed: Schema = table_after(table, history_length())
    let wanted: Schema = declared(table)
    emit_migration(plan(replayed, wanted, 1))
    emit_migration(plan(replayed, wanted, 2))
    emit_migration(plan(replayed, wanted, 3))
    emit_migration(plan(replayed, wanted, 4))
    return 0
}

# The planner, asked to rediscover each committed step from the two schemas on
# either side of it. It must propose the same step at the same key — a rename
# as a rename, never as a drop and an add — and it must propose no policy,
# because the policies in the history were written by a person.
fn emit_regenerated_from(number: Int, last: Int) -> Int {
    if number > last {
        return 0
    }
    let step: Migration = history_step(number)
    print(number)
    emit_migration(plan(
        table_after(step.table, number - 1),
        table_after(step.table, number),
        step.key
    ))
    return emit_regenerated_from(number + 1, last)
}

fn emit_probe(step: Migration) -> Int {
    let target: Schema = table_after(step.table, history_length())
    let other: Schema = table_after(other_table(step.table), history_length())
    let transition: SchemaStep = apply(target, other, step)
    let outcome: SchemaOutcome = step_outcome(transition)
    emit_migration(step)
    print(outcome_kind(outcome))
    print(outcome_payload(outcome))
    # How far the step moved the live count, so the output itself shows that
    # a refusal consumed nothing rather than leaving that to a comment.
    print(live_count(step_schema(transition)) - live_count(target))
    return 0
}

fn main() -> Int {
    print("kofun-boot schema")
    print("contract")
    print(1)

    print("identity")
    print("db.schema")
    print(schema_digest())
    print("end identity")

    print("history")
    print(history_length())
    emit_history_from(1, history_length())
    print("end history")

    print("drift")
    emit_drift(table_users())
    emit_drift(table_posts())
    print(refused_step(history_length()))
    print("end drift")

    print("schema")
    emit_declared(table_users())
    emit_declared(table_posts())
    print("end schema")

    print("plan")
    emit_plan(table_users())
    emit_plan(table_posts())
    print("end plan")

    print("regenerate")
    print(history_length())
    emit_regenerated_from(1, history_length())
    print("end regenerate")

    # Each rule the history never needed to exercise, run once against the
    # replayed database. Every probe must be refused and must leave its table
    # where it was.
    print("probes")
    print(10)
    # The table exists; a second CreateTable is not a way to reset it.
    emit_probe(migration(
        step_create_table(), table_users(), 1, label_id(), kind_bigint(), 0,
        policy_none()
    ))
    # Key 2 is live; an add at a live key is a collision, not an update.
    emit_probe(migration(
        step_add_column(), table_users(), 2, label_nickname(), kind_text(), 1,
        policy_none()
    ))
    # Key 4 was dropped at step 7, and a dropped key stays spent.
    emit_probe(migration(
        step_add_column(), table_users(), 4, label_nickname(), kind_text(), 1,
        policy_none()
    ))
    # Past the bound, the refusal names the bound.
    emit_probe(migration(
        step_add_column(), table_users(), 5, label_nickname(), kind_boolean(), 1,
        policy_none()
    ))
    # A drop with no policy is refused; data loss has to be written down.
    emit_probe(migration(
        step_drop_column(), table_users(), 3, 0, 0, 0, policy_none()
    ))
    # Tightening a nullable column needs the plan to say rows were backfilled.
    emit_probe(migration(
        step_set_nullable(), table_users(), 3, 0, 0, 0, policy_none()
    ))
    # A reference must name the other table's live primary key; users key 3
    # is a live column but not the key a row is identified by.
    emit_probe(referencing(
        step_add_column(), table_posts(), 4, label_nickname(), kind_text(), 1,
        policy_none(), 3
    ))
    # Both ends of a reference keep one kind.
    emit_probe(migration(
        step_alter_kind(), table_posts(), 2, 0, kind_text(), 0, policy_none()
    ))
    # Narrowing loses values; without a policy it is refused.
    emit_probe(migration(
        step_alter_kind(), table_posts(), 3, 0, kind_integer(), 0, policy_none()
    ))
    # Narrowing under Discard nulls every value, which a NOT NULL column
    # cannot hold.
    emit_probe(migration(
        step_alter_kind(), table_users(), 2, 0, kind_boolean(), 0, policy_discard()
    ))
    print("end probes")

    return 0
}
